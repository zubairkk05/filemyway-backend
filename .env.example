# FileMyWay backend (cPanel) - copy to .env and adjust.
# FastAPI reads these via app/core/config.py at startup.

# Origins allowed to call the API. MUST include your Vercel site (exact scheme+host,
# no trailing slash). Add every domain you use, including custom domains.
ALLOWED_ORIGINS=https://filemyway.vercel.app,https://www.filemyway.com,https://filemyway.com

# Absolute, writable directory for uploads/results. Use the app's own folder.
STORAGE_DIR=/home/CPANEL_USER/backend/storage

# Limits
MAX_FILE_MB=100
MAX_TOTAL_MB=500
MAX_PAGES=100
# Fallback only: erases uploads the visitor never downloaded (minutes).
JOB_TTL_MIN=30
# Erase a job this many minutes after its first download (minutes).
POST_DOWNLOAD_GRACE_MIN=5
CONCURRENCY=2

# Secrets - change both before going live.
DOWNLOAD_SECRET=change_me
# Used by the /api/v1/maintenance/cleanup endpoint (cPanel cron calls it).
# Cron (every 10 min):  curl -s -X POST "https://api.yourdomain.com/api/v1/maintenance/cleanup?secret=YOUR_CRON_SECRET"
# Files also expire automatically within ~10 min of the TTL via an in-app sweep.
CRON_SECRET=change_me

# Worker
PY_WORKER_TIMEOUT_SEC=300
PY_WORKER_MEM_MB=1024

# Only used when running uvicorn directly (not under Passenger).
PORT=8000
